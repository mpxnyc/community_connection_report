# Key Messages
## Message 1: Go to interventions miss the mark
---
title: "Manuscript: MPX NYC Intervention Strategy"
---



```{r}
#| fig-width: 7
#| fig-height: 7
#| label: fig-radargroupsex
#| fig-cap: "MPX NYC (2022): Social or Sexual Contact in Group Setting over Past 4 Weeks"
#| 




  targets::tar_read(participant_data) %>%
    mutate(groupSex = factor(groupSex, c("no", "yes"), c("No", "Yes"))) %>%
    group_by(groupSex) %>%
    summarize(count = n()) %>%
    ungroup() %>%
    filter(!is.na(groupSex)) %>%
    mutate(level = groupSex) %>%
    mutate(proportion = count / sum(count)) %>%
  ggplot2::ggplot() + 
        ggplot2::geom_bar(aes(x = level, fill = level, y = proportion), width = 1, stat = "identity") + 
        ggplot2::theme_void() + 
        ggplot2::theme(
                        legend.position = "none", 
                        panel.grid.major.y = ggplot2::element_line(size = 0.1),
                        axis.text.x = element_text(),
                        axis.text.y = element_text()
                        ) + 
        ggplot2::scale_fill_manual(values = c(
                                              mpxnyc_colors$dark_blue, 
                                              mpxnyc_colors$dark_pink, 
                                              mpxnyc_colors$dark_purple, 
                                              mpxnyc_colors$light_blue, mpxnyc_colors$light_pink, 
                                              mpxnyc_colors$light_purple)
          ) + 
    ggplot2::scale_x_discrete(drop = FALSE) +
    ggplot2::scale_y_continuous(labels = scales::percent) + 
    theme(
      plot.margin = margin(2,2,2,2, "cm"),
      plot.title = element_text(hjust = 0.5),
      plot.subtitle = element_text(hjust = 0.5)
    ) + 
    labs(
          title = "Social or sexual contact in group setting over prior 4 weeks",
          subtitle = "MPX NYC, New York, 2022",
          caption = "Data source: MPX NYC 2022")
  

```

---
title: "Manuscript: MPX NYC Intervention Strategy"
---


```{r}
#| fig-cap: "Place Types by Sexual Contact and Distance"
#| fig-width: 7
#| fig-height: 13
#| label: fig-places


labels_place_type <- c(
  "concert" = "Concert/Theatre/Show",
  "theatre/show" = "Concert/Theatre/Show",
  "darkroom" = "Dark Room/Sex Party",
  "sex-party" = "Dark Room/Sex Party",
  "dance-party" = "Dance Party",
  "sport-game" = "Sport Game",
  "private-residence-" = "Private Residence",
  "something-else" = "Something Else"
)
  


 working_data <- targets::tar_read(places_data) %>%
   mutate(placeType = factor(placeType, names(labels_place_type), labels_place_type)) %>%
   mutate(placeSex = factor(placeSex, c("no", "yes"), c("Social\nContact", "Sexual\nContact"))) %>%
  filter(!is.na(placeSex))
 
figure_n_counts <-  working_data %>%
                                group_by() %>%
                                summarize(n = n() )



working_data  %>%
                                arrange(placeType, placeSex, distanceFromHome) %>%
  group_by(placeType) %>%
  summarize(count = n()) %>%
  ungroup() %>%
  mutate(proportion = count / sum(count)) %>%
  ungroup() %>%
                                mutate(prop_label = scales::percent(proportion, accuracy = 1)) %>%
                                ggplot() +
                                geom_bar(aes(x = placeType, y = proportion, fill = placeType), stat = "identity", width = 1) +
                                #geom_text(aes(x = level, y = proportion, label = prop_label), color = "black", nudge_y = 0.35, size = 3) +
                                geom_text(aes(x = 0, y = -0.8, label = paste("n =", n)), data = figure_n_counts, size = 4) +
                                coord_polar() +
                                scale_fill_manual("", values = c(dark_blue, light_blue, dark_purple, light_purple, dark_pink, light_pink, light_green, dark_green))    +
                                scale_color_manual(values = c(
                                  "Dance Party" = dark_blue, 
                                  "Sport Game" = light_blue, 
                                  "Dark Room/Sex Party" = dark_purple, 
                                  "Concert/Theatre/Show" = light_purple, 
                                  "Private Residence" = dark_pink, 
                                  "Something Else" = light_pink))    +
                                theme_void() +
                                theme(
                                  #panel.grid.major = element_line(color = "grey"),
                                  #panel.grid.major = element_line(size = 0.2, color = "grey"),
                                  legend.position = "bottom",
                                  strip.text = element_text( face = "bold", size = 14, margin = margin(5,5,5,5,"mm")),
                                  strip.text.y = element_text(),
                                  plot.margin = margin(2, 2, 2, 2, "cm"),
                                  plot.title = element_text(hjust = 0.5),
                                  plot.subtitle = element_text(hjust = 0.5)
                                ) +
                                scale_y_continuous(breaks = c(0,0.25, 0.50, 1), limits = c(-0.8, 1)) + 
  labs(
          title = "Type of venue for contact over past 4 weeks",
          subtitle = "MPX NYC, New York, 2022",
          caption = "Data source: MPX NYC 2022")
  



```

