                                  "Sport Game" = light_blue, 
                                  "Dark Room/Sex Party" = dark_purple, 
                                  "Concert/Theatre/Show" = light_purple, 
                                  "Private Residence" = dark_pink, 
                                  "Something Else" = light_pink))    +
                                theme_void() +
                                theme(
                                  #panel.grid.major = element_line(color = "grey"),
                                  #panel.grid.major = element_line(size = 0.2, color = "grey"),
                                  legend.position = "bottom",
                                  strip.text = element_text( hjust = 0.5),
                                  strip.text.y = element_text(angle = -90),
                                  plot.margin = margin(2, 2, 2, 2, "cm"),
                                  plot.title = element_text(hjust = 0.5),
                                  plot.subtitle = element_text(hjust = 0.5)
                                ) +
                                scale_y_continuous(breaks = c(0,0.25, 0.50, 1), limits = c(-0.8, 1)) +
