```{r}

make_bar_plot <- function(data){
  
  ggplot2::ggplot(data) + 
    ggplot2::geom_bar(aes(x = level, fill = level, y = proportion), width = 1, stat = "identity") + 
    ggplot2::geom_text(aes(x = level, y = proportion + 0.05, label = count), alpha = 0.7) +
    ggplot2::theme_void() + 
    ggplot2::scale_x_discrete(drop = FALSE) +
    ggplot2::scale_y_continuous("Proportion of participants", labels = scales::percent)
}

make_one_stratum_radar_plot <- function(data){
  
  data_n_counts <- data %>%
    group_by(stratum) %>%
    summarize(n = sum(count))
  data %>%
    mutate(prop_label = scales::percent(proportion, accuracy = 1)) %>%
    ggplot() +
    geom_bar(aes(x = level, y = proportion, fill = level), stat = "identity", width = 1) +
    geom_text(aes(x = 0, y = -0.8, label = paste("n =", n)), data = data_n_counts, size = 5) +
    geom_text(aes(label = prop_label, x = level, y = proportion + 0.3), size = 3, face = "bold", alpha = 0.7) +
    facet_grid( . ~ stratum, switch = "y") +
    coord_polar(clip = FALSE) +
    theme_void() +
    theme(
      legend.position = "bottom",
      strip.text    = element_text( hjust = 0.5),
      strip.text.y  = element_text(),
      plot.title    = element_text(hjust = 0.5),
      plot.subtitle = element_text(hjust = 0.5, margin = margin(1, 0, 15, 0, "mm")),
      plot.caption  = element_text( hjust = 0)
      ) +
    scale_y_continuous(breaks = c(0,0.25, 0.50, 1), limits = c(-0.8, 1))
}

make_two_stratum_radar_plot <- function(data){
    data_n_counts <- data %>%
    group_by(stratum_a, stratum_b) %>%
    summarize(n = sum(count))
  
    data %>%
          mutate(prop_label = scales::percent(proportion, accuracy = 1)) %>%
    ggplot() +
    geom_bar(aes(x = level, y = proportion, fill = level), stat = "identity", width = 1) +
    geom_text(aes(x = 0, y = -0.8, label = paste("n =", n)), data = data_n_counts, size = 5) +
    geom_text(aes(label = prop_label, x = level, y = proportion + 0.3), size = 3, face = "bold", alpha = 0.7) +
    facet_grid( stratum_a ~ stratum_b, switch = "y") +
    coord_polar(clip = FALSE) +
    theme_void() +
    theme(
      legend.position = "bottom",
      strip.text    = element_text( hjust = 0.5),
      strip.text.y  = element_text(),
      plot.title    = element_text(hjust = 0.5),
      plot.subtitle = element_text(hjust = 0.5, margin = margin(1, 0, 15, 0, "mm")),
      plot.caption  = element_text( hjust = 0)
      ) +
    scale_y_continuous(breaks = c(0,0.25, 0.50, 1), limits = c(-0.8, 1))
}

make_map_coverage_plot <- function(){
      graph_data <- targets::tar_read(data_vaccination_coverage_raw) %>%
                      filter(intervention_priority == "contact", intervention_setting == "home.social.sexual") %>%
                      group_by(vax_place) %>%
                      summarize(count = n(), group = first(group)) %>%
        rename(name = vax_place)
      
      mpxnyc::community_sf_obj %>%
        rename(name = 1) %>%
                   left_join(graph_data) %>%
                   ggplot() +
                          geom_sf(fill = "grey") +
                         geom_sf(aes(fill = group, alpha = group), color = "white") +
                         theme_void() +
                         theme(
                           axis.text = element_blank(),
                           legend.position = "bottom"
                         ) +
                         scale_fill_manual(
                           "Intervention Group", 
                                          values = c(
                                                        "Group A" = dark_pink, 
                                                        "Group B" = dark_blue, 
                                                        "Group C" = light_purple
                                                        ), 
                                           na.value = "grey",
                           na.translate = FALSE
                                           ) + 
                         scale_alpha_manual(values = c("Group A" = 1, "Group B" = 1, "Group C" = 0.5)) +
   guides(alpha = "none")
  }


plot_place_network_matrix <- function(data){
  
   data_tiles <- mpxnyc::community_sf_obj %>%
   transmute(to = community, from = community) %>%
   expand(to, from)
   
   
  data %>% 
    ggplot() +
      geom_point(aes(y =from, x = to, size = weight), color = "black", alpha = 0.5) +
    theme_void() +
  theme(
    axis.text = element_text(size = 7, color = "black"),
    axis.text.x = element_text(angle = 90),
    axis.title = element_text(),
    axis.title.y = element_text(angle = 90),
    legend.position = "none"
  ) +
  scale_x_discrete("Destination community district", position = "top") +
  scale_y_discrete("Home community district",  limits=rev) 
}

plot_place_network_viz <- function(){
     graph <- targets::tar_read(data_vaccination_campaign_raw) %>%
                  purrr::keep(
                    function(graph){
                      intervention_priority <- graph %>% 
                                                    activate(nodes) %>%
                                                    pull(intervention_priority) %>%
                                                    {.[1]}
                      
                              intervention_setting <- graph %>% 
                                                    activate(nodes) %>%
                                                    pull(intervention_setting) %>%
                                {.[1]}
                              
                                strata <- graph %>% 
                                                    activate(nodes) %>%
                                                    pull(strata) %>%
                                                    {.[1]}
                              
                 intervention_priority == "contact" & intervention_setting == "home.social.sexual" & strata == "overall"
                              
                    }
                  )
  
  
    graph_data <- targets::tar_read(data_vaccination_coverage_raw) %>%
                      filter(intervention_priority == "contact", intervention_setting == "home.social.sexual") %>%
                      group_by(vax_place) %>%
                      summarize(count = n()) %>%
                      ungroup() %>%
                      arrange(-count) %>%
                      mutate(community = factor(vax_place, unique(vax_place))) %>%
                      mutate(prop = count / sum(count)) %>%
                      mutate(cumprop = cumsum(prop)) %>%
                      mutate(group = "Group A") %>%
                      mutate(group = ifelse(cumprop > 0.33, "Group B", group)) %>%
                      mutate(group = ifelse(cumprop > 0.66, "Group C", group)) %>%
                      mutate(group = lead(group)) %>%
                      mutate(group = ifelse(is.na(group), "Group C", group)) %>%
                      mutate(name = community)
    
    
    
    
  place_graph <- graph[[1]] %>%
                      igraph::bipartite_projection(which = "false") %>%
                      as_tbl_graph() %>%
                      select(name) %>%
                      left_join(graph_data)
  
 place_graph %>%
    activate(nodes) %>%
    mutate(deg = igraph::degree(.)) %>%
    filter(deg > 0) %>%
    filter(!is.na(group)) %>%
    ggraph() +
      geom_edge_link( aes(filter = weight > 10), alpha = 0.5, linewidth = 4) +
      geom_edge_link( aes(linewidth = weight, filter = weight <= 10 & weight > 5), alpha = 0.5, , linewidth = 1) +
      geom_edge_link( aes(linewidth = weight, filter = weight <= 5 ), alpha = 0.5, , linewidth = 0.1) +
      geom_node_label(aes(label = name , color = group, size = prop)) +
      theme_void() +
      scale_color_manual(values = c("Group A" = dark_pink, "Group B" = dark_blue, "Group C" = "grey")) +
      scale_linewidth_continuous() +
      theme(
        legend.position = "none",
        plot.margin = margin(0,0,0,0, "cm"),
        plot.title = element_text(hjust = 0.5),
        plot.subtitle = element_text(hjust = 0.5),
        plot.caption = element_text(hjust = 0)
      ) 
  
}

```


