## Spatial mixing 











```{r }
#| fig-width: 7
#| fig-height: 9
#| 
data <- targets::tar_read(plotdata_place_census_age)  

jnk <- classInt::classIntervals(data$proportion, n = 5, style = "jenks")

data |> dplyr::mutate(proportion = cut(proportion, breaks = jnk$brks, include.lowest = TRUE)) |>
  plot_placecensus_map() +
                  ggplot2::scale_fill_brewer(name = "", na.translate = FALSE) +
                theme_mpxnyc_blank(legend.position = "bottom",
                                strip.text.y.left = ggplot2::element_text(size = 14, angle = 65, margin = ggplot2::margin(0,0,0,0), color = "#636363"),
                                strip.clip = "off")  
```

```{r}
#| fig-cap: Spatial mixing matrix by age
#| label: fig-age-mixing-matrix
#| fig-width: 5
#| fig-height: 6

targets::tar_read(plotdata_age_mixing_matrix) |>
  plot_matrix_mixing() +
  scale_fill_mpxnyc_gradient("Spatial\nmixing\ncoefficient", labels = scales::label_percent(), breaks = c(-0.5, 0, 0.5, 1), limits = c(-0.5, 1)) +
  scale_color_mpxnyc_gradient() +
  ggplot2::scale_alpha_discrete(guide = "none") +
  theme_mpxnyc_mixing() 
```

```{r }
#| fig-width: 7
#| fig-height: 9
#| 
data <- targets::tar_read(plotdata_place_census_sexorientation)  

jnk <- classInt::classIntervals(data$proportion, n = 5, style = "jenks")

data |> dplyr::mutate(proportion = cut(proportion, breaks = jnk$brks, include.lowest = TRUE)) |>
  plot_placecensus_map() +
                  ggplot2::scale_fill_brewer(name = "", na.translate = FALSE) +
                theme_mpxnyc_blank(legend.position = "bottom",
                                strip.text.y.left = ggplot2::element_text(size = 14, angle = 65, margin = ggplot2::margin(0,0,0,0), color = "#636363"),
                                strip.clip = "off")  
```

```{r }
#| fig-cap: Spatial mixing matrix by sexual orientation
#| label: fig-sexorientation-mixing-matrix
#| fig-width: 6
#| fig-height: 6


targets::tar_read(plotdata_sexorientation_mixing_matrix) |>
  dplyr::filter(ego_level != "Something Else", alter_level != "Something Else") |> 
  plot_matrix_mixing() +
  scale_fill_mpxnyc_gradient("Spatial\nmixing\ncoefficient", labels = scales::label_percent(), breaks = c(-0.5, 0, 0.5, 1), limits = c(-0.5,  1.2)) +
  scale_color_mpxnyc_gradient() +
  ggplot2::scale_alpha_discrete(guide = "none") +
  theme_mpxnyc_mixing() 

```

```{r }
#| fig-width: 7
#| fig-height: 18
#| 
data <- targets::tar_read(plotdata_place_census_racegender)  

jnk <- classInt::classIntervals(data$proportion, n = 5, style = "jenks")

data |> dplyr::mutate(proportion = cut(proportion, breaks = jnk$brks, include.lowest = TRUE)) |>
  plot_placecensus_map() +
                  ggplot2::scale_fill_brewer(name = "", na.translate = FALSE) +
                theme_mpxnyc_blank(legend.position = "bottom",
                                strip.text.y.left = ggplot2::element_text(size = 14, angle = 65, margin = ggplot2::margin(0,0,0,0), color = "#636363"),
                                strip.clip = "off")  
```

```{r}
#| fig-cap: Spatial mixing matrix by race and gender.
#| label: fig-racegender-mixing-matrix
#| fig-width: 9
#| fig-height: 9

targets::tar_read(plotdata_racegender_mixing_matrix) |>
    dplyr::filter(ego_level != "Another demographic", alter_level != "Another demographic") |> 
  plot_matrix_mixing() +
  scale_fill_mpxnyc_gradient("Spatial\nmixing\ncoefficient", labels = scales::label_percent(), breaks = c(-2, 0,  2), limits = c(-2, 2)) +
  scale_color_mpxnyc_gradient() +
  ggplot2::scale_alpha_discrete(guide = "none") +
  theme_mpxnyc_mixing()
```

