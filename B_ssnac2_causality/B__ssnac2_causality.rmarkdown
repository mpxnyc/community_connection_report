```






$$
\begin{aligned}
\mathbf{\Psi}_{0i} &=   f_{\mathbf{\Psi}_{0i}}(U_{\mathbf{\Psi}_{0i}})\\
M_{0i} &=  f_{M_0}(U_{M_{0i}}) \\
V_{0i} &=  f_{V_0}(U_{V_{0i}}) \\
R_{sj} &=  f_{R}(U_{R_{sj}}, \mathbf{V}_{s-1}) \\
T_{sj} &=  f_{T}(U_{T_{sj}}, R_{s,j}) \\
\mathbf{\Psi}_{si} &=   f_{\mathbf{\Psi}_{si}}(U_{\mathbf{\Psi}_{si}}, \mathbf{V}_{s-1}, \mathbf{\Psi}_{\{s-1,i\}})\\
M_{si} &=  f_{M} (U_{M_{\{si\}}} , V_{\{s-1,i\}}, M_{\{s-1,i\}}, \mathbf{T}_{s}, \mathbf{\Psi}_{si})\\
V_{si} &=  f_{V}(U_{V_{\{si\}}}, M_{\{si\}}, V_{\{s-1,i\}}) \\
\end{aligned}
$$ {#eq-placeintervention-dang}










